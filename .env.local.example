# NAYSPERA — environment configuration
# Copy this file to .env.local and fill in only what you have.
# The prototype runs fully without any of these values: features that need
# them show an honest "not connected" state instead of faking results.

# --- AI generation (server only, never exposed to the browser) ---
# Any OpenAI-compatible chat-completions endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid
OPENAI_MODEL=gpt-4o-mini

# --- Backend API (provided by the backend developer) ---
# Base URL of the REST API the prototype should call once the backend exists.
# Leave empty to keep using the local demo store in lib/storage.js.
NEXT_PUBLIC_API_BASE_URL=
